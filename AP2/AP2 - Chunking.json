    {
      "parameters": {
        "jsCode": "// Este script transforma cada linha do CSV em um formato ideal para o Vector Store\nconst items = $('Ler CSV').all();\nreturn items.map(item => {\n  // Remove BOM (caractere invisível) dos nomes das colunas\n  const data = Object.fromEntries(\n    Object.entries(item.json).map(([key, value]) => [\n      key.replace(/^\\uFEFF/, ''),\n      value\n    ])\n  );\n  \n  // 1. Criamos um \"Texto Rico\" apenas com dados relevantes para a busca semântica\n  //const conteudo_semantico = `Produto: ${data['APRESENTAÇÃO']}. Princípio Ativo: ${data['PRINCIPIO ATIVO']}.`;\n  const conteudo_semantico = `${data['APRESENTAÇÃO']}`;\n  \n  // 2. Retornamos o texto para a IA, junto com os metadados baseados no seu script Python\n  return {\n    json: {\n      conteudo_semantico: conteudo_semantico, // <-- O que vai para o Embeddings\n      \n      // Metadados (O que vai para o Qdrant)\n      sap: data['CÓDIGO SAP'],\n      nome: data['APRESENTAÇÃO'],\n      principio_ativo: data['PRINCIPIO ATIVO'],\n      familia: data['FAMÍLIA'],\n      ncm: data['NCM (CLASS FISCAL)'],\n      tipo: data['TIPO DE MEDICAMENTO'],\n      tarja: data['TARJA'],\n      qtde: data['QTDE'],\n      \n      // Construindo o dicionário de preços igual ao script Python\n      precos: {\n        icms_0:   { pf: data[\"ICMS 0 % (PF)\"], pmc: data[\"ICMS 0 % (PMC)\"] },\n        icms_12:  { pf: data[\"ICMS 12 %  (PF)\"], pmc: data[\"ICMS 12 % (PMC) \"] },\n        icms_17:  { pf: data[\"ICMS 17 % (PF)\"], pmc: data[\"ICMS 17 % (PMC)\"] },\n        icms_175: { pf: data[\"ICMS 17,5 % (PF)\"], pmc: data[\"ICMS 17,5 % (PMC)\"] },\n        icms_18:  { pf: data[\"ICMS 18 %  (PF)\"], pmc: data[\"ICMS 18 %  (PMC)\"] },\n        icms_20:  { pf: data[\"ICMS 20 % (PF)\"], pmc: data[\"ICMS 20 % (PMC)\"] },\n        icms_17_ac_rr: { pf: data[\"ICMS 17 % (ALC) AC/RR (PF)\"], pmc: data[\"ICMS 17 % (ALC) AC/RR (PMC)\"] },\n        icms_175_ro:   { pf: data[\"ICMS 17,5 % (ALC) RO (PF)\"],   pmc: data[\"ICMS 17,5 % (ALC) RO (PMC)\"] },\n        icms_18_am_ap: { pf: data[\"ICMS 18 % (ALC) AM/AP (PF)\"],   pmc: data[\"ICMS 18 % (ALC) AM/AP (PMC)\"] }\n      },\n      \n      ean: data['CÓDIGO EAN'] ? String(data['CÓDIGO EAN']) : null,\n      registro_ms: data['REGISTRO MS'] ? String(data['REGISTRO MS']) : null\n    }\n  };\n});"
      },
